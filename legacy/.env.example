# Sekrety Edge Functions — ustawić w Supabase Dashboard -> Settings ->
# Edge Functions -> Secrets (albo `supabase secrets set`), NIE w repo.
# SUPABASE_URL i SUPABASE_SERVICE_ROLE_KEY Supabase ustawia automatycznie
# dla Edge Functions — nie trzeba ich dodawać ręcznie.

# Do paragonów (ingest-receipt) i kategoryzacji nieznanych sklepów modelem.
ANTHROPIC_API_KEY=sk-ant-...

# Opcjonalnie, do powiadomień (sekcja 4.6 specu) — jeśli wdrożysz ntfy.
NTFY_TOPIC=budget-tomek-xxxxx
